{
  "name": "uit_assistance",
  "version": "1.0.0",
  "description": "UIT Assistant Web & AI Grounding Chatbot",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:build": "docker build -t uit-assistance .",
    "docker:run": "./scripts/run-image.sh",
    "docker:stop": "docker stop uit_assistant_app && docker rm uit_assistant_app",
    "docker:save": "docker save -o uit-assistance-image.tar uit-assistance",
    "docker:load": "docker load -i uit-assistance-image.tar",
    "docker:compose": "docker compose up -d --build",
    "docker:compose:down": "docker compose down"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
